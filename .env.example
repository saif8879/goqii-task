# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#
# Docker Compose reads this file for the local stack. The API also reads it when
# run directly or via a CLI script; real environment variables always take
# precedence, so a container's own configuration is never overridden.

# --- Database -----------------------------------------------------------------
DB_NAME=taskmanager
DB_USER=taskuser
DB_PASS=change-me

# Only used when running the API outside Docker. Compose sets these itself.
DB_HOST=127.0.0.1
DB_PORT=3307

# Root password for the local MySQL container.
MYSQL_ROOT_PASSWORD=change-me-too

# --- Authentication -----------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
# Rotating this invalidates every issued access token, which signs everyone out.
JWT_SECRET=

# --- HTTP ---------------------------------------------------------------------
# Origins allowed to make credentialed requests, comma-separated. Credentialed
# CORS forbids a wildcard, so each front end origin must be listed explicitly.
CORS_ORIGIN=http://localhost:5173

# Marks the refresh cookie Secure so it is only ever sent over HTTPS. Defaults
# to true. Set to false only for local plain-HTTP development, otherwise the
# browser discards the cookie and sessions will not survive a reload.
COOKIE_SECURE=false

# Lax is right when the API and front end share a registrable domain. Unrelated
# domains need None, which browsers only accept alongside COOKIE_SECURE=true.
COOKIE_SAMESITE=Lax

# --- Host ports for the local stack ------------------------------------------
API_PORT=8080
DB_PORT_HOST=3307
